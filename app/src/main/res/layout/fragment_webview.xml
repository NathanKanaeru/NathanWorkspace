<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:animateLayoutChanges="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="1dp"
        app:contentPadding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:enabled="false"
                android:contentDescription="Go back"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_forward"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:enabled="false"
                android:contentDescription="Go forward"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_logs"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/tv_url_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_url"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="remotedesktop.google.com"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:contentDescription="Home"
                app:icon="@drawable/ic_home"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:contentDescription="Refresh"
                app:icon="@drawable/ic_refresh"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_external"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:contentDescription="Open in browser"
                app:icon="@drawable/ic_open_in_browser"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_toolbar" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/card_shortcuts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_bar" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Ketik CRD code di tab Run,\nlalu akses remote desktop di sini"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/card_shortcuts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== SHORTCUT BAR ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_shortcuts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surfaceContainerLow"
        app:cardCornerRadius="0dp"
        app:cardElevation="1dp"
        app:contentPadding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="0dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_esc"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Tombol Esc"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="Esc"
                    android:textSize="12sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_ctrl"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Tombol Ctrl"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="Ctrl"
                    android:textSize="12sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_alt"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Tombol Alt"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="Alt"
                    android:textSize="12sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_tab"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Tombol Tab"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="Tab"
                    android:textSize="12sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_up"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Panah atas"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="↑"
                    android:textSize="16sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_down"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Panah bawah"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="↓"
                    android:textSize="16sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_left"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Panah kiri"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="←"
                    android:textSize="16sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_right"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Panah kanan"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="→"
                    android:textSize="16sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_enter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Tombol Enter"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="Enter"
                    android:textSize="12sp"
                    app:cornerRadius="9999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_k_backspace"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Tombol Backspace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="44dp"
                    android:text="⌫"
                    android:textSize="16sp"
                    app:cornerRadius="9999dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
